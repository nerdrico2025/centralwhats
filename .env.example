# === WA Manager — variáveis de ambiente ===
# Copie para .env e ajuste. Nunca comite .env com segredos reais.

# Ambiente
NODE_ENV=development

# Servidor HTTP
PORT=3000

# Banco de dados: escolhe o adapter de repo.*
# sqlite (dev) | postgres (prod)
DB_DRIVER=sqlite

# Caminho do arquivo SQLite (usado quando DB_DRIVER=sqlite)
SQLITE_PATH=./wa-manager.sqlite

# String de conexão Postgres (usada quando DB_DRIVER=postgres)
# postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Chave para criptografar segredos em repouso (tokens Meta, sessão Baileys).
# Gere uma string longa e aleatória. Obrigatória em produção.
SECRETS_ENCRYPTION_KEY=

# Limiar do delay híbrido do motor de fluxos, em segundos (default 10).
# Abaixo: dorme inline (ritmo natural do bot). No limiar ou acima: persiste
# next_step_at e retoma via processPendingExecutions (nunca segura o processo).
# FLOW_DELAY_INLINE_THRESHOLD_S=10

# Timeout de limpeza de execuções de fluxo PRESAS, em horas (default 48).
# Execuções ativas paradas há mais que isso (e sem retomada futura agendada)
# são canceladas COM log na varredura. Delays longos legítimos não são tocados.
# FLOW_STUCK_TIMEOUT_H=48

# Segredo do cron de campanhas (P3.2). A Vercel injeta automaticamente como
# "Authorization: Bearer <CRON_SECRET>" nas chamadas agendadas (vercel.json
# §crons). Gere uma string longa e aleatória. SEM esta variável a rota
# /api/cron/tick-campaigns responde 503 e não processa nada — campanhas só
# avançam por webhook/UI. Nunca a deixe vazia em produção.
CRON_SECRET=

# App Secret do app da Meta — valida a assinatura (X-Hub-Signature-256) do
# POST /webhook. NÃO é o verify_token nem o token de acesso da instância: é um
# segredo por App Meta (App Dashboard → Configurações do app → Básico).
# OBRIGATÓRIA: sem ela o webhook recusa TODO evento (fail-closed) — nenhuma
# mensagem recebida é processada, nenhum fluxo dispara.
META_APP_SECRET=

# === V2 (multi-tenancy) ===
# Segredo do JWT (login/registro). Obrigatório em produção — gere uma string
# longa e aleatória. Sem usuários cadastrados, o sistema opera em modo
# bootstrap (org default, sem login) — o primeiro registro tranca o acesso.
# JWT_SECRET=
