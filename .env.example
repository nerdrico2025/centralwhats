# === WA Manager — variáveis de ambiente ===
# Copie para .env e ajuste. Nunca comite .env com segredos reais.

# Ambiente
NODE_ENV=development

# Servidor HTTP
PORT=3000

# Banco de dados: escolhe o adapter de repo.*
# sqlite (dev) | postgres (prod)
DB_DRIVER=sqlite

# Caminho do arquivo SQLite (usado quando DB_DRIVER=sqlite)
SQLITE_PATH=./wa-manager.sqlite

# String de conexão Postgres (usada quando DB_DRIVER=postgres)
# postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Chave que criptografa os segredos EM REPOUSO: instances.token,
# instances.verify_token e a sessão do Baileys (baileys_auth.value).
# AES-256-GCM, valores gravados com o prefixo "enc:v1:". Obrigatória em
# produção. A MESMA chave precisa estar na Vercel e no worker (Railway) — com
# chaves diferentes um não lê o que o outro gravou (erro alto, nunca silencioso).
# PERDER A CHAVE = dados cifrados irrecuperáveis (recuperação: re-cadastrar o
# token da Meta e re-escanear o QR). Backfill do que já está em texto claro:
# `npm run encrypt-secrets` (idempotente, roda DEPOIS do deploy do código).
SECRETS_ENCRYPTION_KEY=

# Limiar do delay híbrido do motor de fluxos, em segundos (default 10).
# Abaixo: dorme inline (ritmo natural do bot). No limiar ou acima: persiste
# next_step_at e retoma via processPendingExecutions (nunca segura o processo).
# FLOW_DELAY_INLINE_THRESHOLD_S=10

# Timeout de limpeza de execuções de fluxo PRESAS, em horas (default 48).
# Execuções ativas paradas há mais que isso (e sem retomada futura agendada)
# são canceladas COM log na varredura. Delays longos legítimos não são tocados.
# FLOW_STUCK_TIMEOUT_H=48

# Segredo do cron de campanhas (P3.2). A Vercel injeta automaticamente como
# "Authorization: Bearer <CRON_SECRET>" nas chamadas agendadas (vercel.json
# §crons). Gere uma string longa e aleatória. SEM esta variável a rota
# /api/cron/tick-campaigns responde 503 e não processa nada — campanhas só
# avançam por webhook/UI. Nunca a deixe vazia em produção.
CRON_SECRET=

# App Secret do app da Meta — valida a assinatura (X-Hub-Signature-256) do
# POST /webhook. NÃO é o verify_token nem o token de acesso da instância: é um
# segredo por App Meta (App Dashboard → Configurações do app → Básico).
# OBRIGATÓRIA: sem ela o webhook recusa TODO evento (fail-closed) — nenhuma
# mensagem recebida é processada, nenhum fluxo dispara.
META_APP_SECRET=

# === Worker Baileys (V2) — todas OPCIONAIS, com default sensato ===
# Elas vivem só no worker (Railway). A camada web ignora todas.

# Intervalo da varredura de instâncias, em segundos (default 30). É o que faz
# instância criada DEPOIS do boot ganhar socket sem reiniciar o serviço, e o
# que fecha o socket de instância desativada.
# WORKER_SCAN_INTERVAL_S=30

# Quanto tempo um item pode ficar 'pending' na outbox de uma instância SEM
# socket antes de virar falha explícita, em minutos (default 60). Serve de teto
# também para o retry de erro transitório — sem isso, um transitório eterno
# giraria para sempre.
# OUTBOX_STALE_MINUTES=60

# Intervalo MÍNIMO entre dois envios da mesma instância, em ms (default 1000).
# O WhatsApp Web não devolve rate-limit por mensagem: excesso de envio vira
# queda de conexão e, no limite, bloqueio do número. Este é o freio na origem —
# retry não protege contra isso. NÃO é medição: é ponto de partida conservador.
# BAILEYS_MIN_SEND_INTERVAL_MS=1000

# Verbosidade do log da lib Baileys (trace|debug|info|warn|error, default warn).
# Em 'info' o Baileys é muito barulhento; erros reais aparecem em 'warn'.
# WORKER_BAILEYS_LOG_LEVEL=warn

# Validade da foto de perfil do contato, em horas (default 24). Passado o TTL,
# a próxima mensagem daquele contato dispara uma nova consulta.
# AVATAR_TTL_HOURS=24

# Intervalo mínimo entre consultas de FOTO DE PERFIL da mesma instância, em ms
# (default 2000). Mais lento que o de envio de propósito: avatar é acessório, e
# o risco a evitar é o mesmo (rajada de consultas a partir de um número só).
# BAILEYS_MIN_PROFILE_INTERVAL_MS=2000

# === V2 (multi-tenancy) ===
# Segredo do JWT (login/registro). Obrigatório em produção — gere uma string
# longa e aleatória. Sem usuários cadastrados, o sistema opera em modo
# bootstrap (org default, sem login) — o primeiro registro tranca o acesso.
# JWT_SECRET=

# Registro público de novas organizações. FAIL-CLOSED: ausente = FECHADO.
# No modelo agência, quem cria conta de cliente é o operador e usuário novo
# entra por CONVITE (tela Equipe). Fora do modo bootstrap, POST /api/auth/register
# responde 403 enquanto esta variável não for exatamente "true".
# Exceção permanente: durante o bootstrap (zero usuários) o registro sempre
# responde — é como o primeiro owner nasce.
# PUBLIC_SIGNUP=false
