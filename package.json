{
  "name": "wa-manager",
  "version": "0.1.0",
  "description": "Plataforma de gestão de WhatsApp (WA Manager) — V1 API Oficial Meta",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "dist/http/server.js",
  "scripts": {
    "dev": "npm run build:web && tsx watch src/http/server.ts",
    "build:web": "node scripts/build-web.mjs",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "start": "node dist/http/server.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"src/web/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/repo/migrate.ts",
    "audit-instances": "tsx src/scripts/auditInstances.ts",
    "create-owner": "tsx src/scripts/createOwner.ts",
    "encrypt-secrets": "tsx src/scripts/encryptSecrets.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:prod": "node dist/worker/index.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.7.5",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": "22.x"
  }
}
